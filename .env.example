# Copy this file to `.env.local` and adjust if your backend is not on :8000.
#
#   cp .env.example .env.local
#
# Both point at the same backend. They are separate because REST and WebSocket
# reach it by different routes:
#
#  - BACKEND_URL is used by the Next.js rewrite in next.config.mjs, so the
#    browser calls /api/... on this origin and Next proxies it. That keeps REST
#    same-origin, which is what lets the refresh cookie work.
#
#  - NEXT_PUBLIC_BACKEND_WS_URL is used by the browser directly. Next.js
#    rewrites do not apply to WebSocket upgrades, so the live task stream has to
#    know the backend's real address. Being NEXT_PUBLIC_, it is baked into the
#    client bundle: never put a secret in it.

BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000
